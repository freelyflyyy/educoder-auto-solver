{
  "name": "cf-ssh-exec",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": ["SSH_API_KEY"]
  },
  "ratelimits": [
    {
      "name": "SSH_RATE_LIMITER",
      "namespace_id": "20731093",
      "simple": { "limit": 120, "period": 60 }
    }
  ]
}
