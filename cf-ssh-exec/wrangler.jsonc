{
  "name": "cf-ssh-exec",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": ["SSH_TARGET_ADMIN_TOKEN"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "SSH_TARGET_REGISTRY", "class_name": "SshTargetRegistry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SshTargetRegistry"] }
  ],
  "ratelimits": [
    {
      "name": "SSH_RATE_LIMITER",
      "namespace_id": "20731093",
      "simple": { "limit": 120, "period": 60 }
    }
  ]
}
